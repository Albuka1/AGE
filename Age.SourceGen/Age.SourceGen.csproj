<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Age.SourceGen</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- This project is a build tool rather than a part of a game, so it has no device to speak to and the names of the keys of
         a window mean nothing in it. -->
    <AgeSilkInputAliases>false</AgeSilkInputAliases>
    <!-- The diagnostics of this generator are read in the build of an assembly, not shipped as a rule set of a package,
         so they need no release tracking file. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- The compiler loads this assembly, so a game never ships it. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
