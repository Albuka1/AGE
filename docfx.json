{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "Age.Assets/Age.Assets.csproj",
            "Age.Audio/Age.Audio.csproj",
            "Age.Content/Age.Content.csproj",
            "Age.Core/Age.Core.csproj",
            "Age.Input/Age.Input.csproj",
            "Age.Physics/Age.Physics.csproj",
            "Age.Rendering/Age.Rendering.csproj",
            "Age.UI/Age.UI.csproj"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",

      // The metadata step compiles the projects it is given against everything they reference, so a project that
      // declares no XML documentation still contributes its public types to the reference: `Age.Content.Lint` is a
      // tool of the build and not part of the engine, and `Age.Sample` is a game rather than an assembly of it. The
      // filter is what keeps a type out of the site, by its name.
      "filter": "tools/docfx/filter.yml"
    }
  ],
  "build": {
    "content": [
      { "src": "docs", "files": ["**/*.md", "toc.yml"] },
      { "files": ["QUICKSTART.md"] },
      { "files": ["api/**/*.yml"] }
    ],
    "resource": [
      { "files": ["LICENSE"] },
      { "src": "Resources/Textures/Logo", "files": ["**/*.svg", "**/*.png"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Auae Game Engine",
      "_appFooter": "Copyright (c) 2026 Albuka1. MIT License.",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "favicon.svg",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Albuka1/Age",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://albuka1.github.io/AGE"
    }
  }
}
