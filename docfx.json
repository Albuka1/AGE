{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "Age.Assets/**/*.csproj",
            "Age.Audio/**/*.csproj",
            "Age.Core/**/*.csproj",
            "Age.Input/**/*.csproj",
            "Age.Physics/**/*.csproj",
            "Age.Rendering/**/*.csproj",
            "Age.UI/**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      { "src": "docs", "files": ["**/*.md"] },
      { "files": ["toc.yml"] },
      { "files": ["api/**/*.yml"] },
      { "files": ["README.md", "CHANGELOG.md", "CODE_OF_CONDUCT.md", "SECURITY.md", "PROGRESS.md"] }
    ],
    "resource": [
      { "files": ["LICENSE"] },
      { "src": "docs", "files": ["images/**/*.svg", "images/**/*.png", "images/**/*.ico"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Auae Game Engine",
      "_appFooter": "Copyright (c) 2026 Albuka1. MIT License.",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg"
    }
  }
}
