{
  "metadata": [
    {
      "src": [{ "src": "src", "files": ["**/*.csproj"] }],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      { "src": "docs", "files": ["**/*.md"] },
      { "files": ["toc.yml"] },
      { "files": ["api/**/*.yml"] },
      { "files": ["README.md", "CHANGELOG.md", "CODE_OF_CONDUCT.md", "SECURITY.md"] }
    ],
    "resource": [
      { "files": ["LICENSE"] },
      { "src": "docs", "files": ["images/**/*.svg", "images/**/*.png", "images/**/*.ico"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Auae Game Engine",
      "_appFooter": "Copyright (c) 2026 Albuka1. MIT License.",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg"
    }
  }
}
