<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Age.Rendering</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Silk.NET.Core" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="StbTrueTypeSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Age.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The branding images live in the shared Resources folder. The logical name keeps them addressable as
         Age.Rendering.Resources.Textures.*, so where the project sits on disk does not reach the assembly. -->
    <EmbeddedResource Include="$(AgeResources)Textures/Icons/icon-20.png" LogicalName="Age.Rendering.Resources.Textures.Icons.icon-20.png" />
    <EmbeddedResource Include="$(AgeResources)Textures/Icons/icon-40.png" LogicalName="Age.Rendering.Resources.Textures.Icons.icon-40.png" />
    <EmbeddedResource Include="$(AgeResources)Textures/Icons/icon-60.png" LogicalName="Age.Rendering.Resources.Textures.Icons.icon-60.png" />
    <EmbeddedResource Include="$(AgeResources)Textures/Logo/logo-320.png" LogicalName="Age.Rendering.Resources.Textures.Logo.logo-320.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Age.Assets\Age.Assets.csproj" />
    <ProjectReference Include="..\Age.Core\Age.Core.csproj" />
    <ProjectReference Include="..\Age.UI\Age.UI.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <AgeComponentRegistrations>RenderingComponentRegistrations</AgeComponentRegistrations>
    <AgeComponentsJsonContext>AgeRenderingJsonContext</AgeComponentsJsonContext>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="AgeComponentRegistrations" />
    <CompilerVisibleProperty Include="AgeComponentsJsonContext" />
    <ProjectReference Include="..\Age.SourceGen\Age.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
