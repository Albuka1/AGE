<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Age.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests read the whole shared Resources folder, the recordings included, so a fixture is the file the
         repository ships rather than a copy of it. -->
    <None Include="$(AgeResources)**" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Age.Content\Age.Content.csproj" />
    <ProjectReference Include="..\Age.Core\Age.Core.csproj" />
    <ProjectReference Include="..\Age.Assets\Age.Assets.csproj" />
    <ProjectReference Include="..\Age.Input\Age.Input.csproj" />
    <ProjectReference Include="..\Age.Audio\Age.Audio.csproj" />
    <ProjectReference Include="..\Age.Physics\Age.Physics.csproj" />
    <ProjectReference Include="..\Age.UI\Age.UI.csproj" />
    <ProjectReference Include="..\Age.Rendering\Age.Rendering.csproj" />
  </ItemGroup>

</Project>
