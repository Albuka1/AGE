<Project>

  <ItemGroup Condition="'$(AgeSilkInputAliases)' == 'true'">
    <Using Include="Silk.NET.Input.Key" Alias="Key" />
    <Using Include="Silk.NET.Input.MouseButton" Alias="MouseButton" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Albuka1</Authors>
    <Company>Albuka1</Company>
    <Product>Auae Game Engine</Product>
    <Version>0.4.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Albuka1/Age</RepositoryUrl>

    <!-- A key and a button are the names of the device that a window reports through, which is Silk.NET for this engine, so the
         two names are the same everywhere and no project keeps a list of the keys it knows. Every assembly of the engine speaks
         them without a using of its own, which is why the package is here rather than in the assemblies that use a device, and a
         project that is a build tool rather than a part of a game turns the two names off instead. -->
    <AgeSilkInputAliases>true</AgeSilkInputAliases>

    <!-- Projects sit in folders named after them at the repository root, and every build writes into one bin/ and one obj/ at
         the root rather than into a pair beside each project: a person finds the output of the whole solution in one place, and
         a folder per project inside it keeps two projects that share a name of an assembly from writing over one another. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>

    <!-- Every asset the repository ships sits in one Resources/ folder at the root, split by kind, so a
         project embeds a file from there or copies the folder next to its output. -->
    <AgeResources>$(MSBuildThisFileDirectory)Resources/</AgeResources>
  </PropertyGroup>

</Project>
