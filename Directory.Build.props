<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Albuka1</Authors>
    <Company>Albuka1</Company>
    <Product>Auae Game Engine</Product>
    <Version>0.3.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Albuka1/Age</RepositoryUrl>

    <!-- Projects sit in folders named after them at the repository root, so every build
         writes to one shared artifacts/ folder instead of a bin/obj pair per project. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>

    <!-- Every asset the repository ships sits in one Resources/ folder at the root, split by kind, so a
         project embeds a file from there or copies the folder next to its output. -->
    <AgeResources>$(MSBuildThisFileDirectory)Resources/</AgeResources>
  </PropertyGroup>

</Project>
